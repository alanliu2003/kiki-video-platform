# Copy this file to .env and adjust values for your machine.
# Do not commit .env. These defaults are for local development only.

# PostgreSQL
POSTGRES_DB=video_platform
POSTGRES_USER=video
POSTGRES_PASSWORD=video
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis (scaffolded for later milestones; unused by the app in Milestone 1)
REDIS_PORT=6379
