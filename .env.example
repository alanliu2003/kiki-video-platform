# Copy this file to .env and adjust values for your machine.
# Do not commit .env. These defaults are for local development only.

# PostgreSQL
POSTGRES_DB=video_platform
POSTGRES_USER=video
POSTGRES_PASSWORD=video
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_VIDEO_BUCKET=videos
# Community MinIO CORS (global). Bucket PutBucketCors is not available. Default * matches MinIO.
# Presigned object GETs do not send cookies. Restrict in production-like deploys if desired.
MINIO_API_CORS_ALLOW_ORIGIN=*

# Legacy single-request multipart upload (Spring DataSize)
VIDEO_MAX_UPLOAD_SIZE=1GB

# Chunked / resumable uploads
VIDEO_MAX_FILE_SIZE=10GB
VIDEO_UPLOAD_CHUNK_SIZE=8MB
VIDEO_UPLOAD_SESSION_TTL=24h
VIDEO_UPLOAD_CLEANUP_INTERVAL=15m

# Redis (interaction counters / cache / danmaku pub-sub / view dedupe / trending + recommendation cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_INTERACTION_TTL=10m
REDIS_COMMENT_RATE_LIMIT=20
REDIS_COMMENT_RATE_WINDOW=1m

# Danmaku
DANMAKU_HISTORY_WINDOW=60s
DANMAKU_MAX_LENGTH=200
DANMAKU_RATE_LIMIT=10
DANMAKU_RATE_WINDOW=10s
DANMAKU_REDIS_CHANNEL=kiki:danmaku
DANMAKU_TIMESTAMP_TOLERANCE=2s
DANMAKU_LEGACY_MAX_TIMESTAMP=6h

# Spring datasource (defaults match the Compose Postgres service)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/video_platform
SPRING_DATASOURCE_USERNAME=video
SPRING_DATASOURCE_PASSWORD=video

# JWT (local development only — do not use this secret outside this machine)
JWT_SECRET=dev-only-jwt-secret-change-before-any-real-use-32b
JWT_ACCESS_TOKEN_TTL=1h

# RocketMQ
ROCKETMQ_ENABLED=true
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_MEDIA_TOPIC=media-processing
ROCKETMQ_MEDIA_PRODUCER_GROUP=kiki-media-api
ROCKETMQ_MEDIA_CONSUMER_GROUP=kiki-media-worker

# Media processing / FFmpeg worker
MEDIA_WORKER_PORT=8081
VIDEO_PROCESSING_TEMP_DIR=
VIDEO_PROCESSING_TIMEOUT=30m
VIDEO_HLS_SEGMENT_DURATION=6
VIDEO_PROCESSING_MAX_ATTEMPTS=3
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_OUTBOX_POLL_INTERVAL=5s

# Elasticsearch (search projection — LOCAL DEVELOPMENT ONLY, security disabled)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_VIDEO_INDEX=kiki-videos
ELASTICSEARCH_VIDEO_INDEX_VERSION=kiki-videos-v1
SEARCH_OUTBOX_POLL_INTERVAL=5s
SEARCH_OUTBOX_STALE_AFTER=1m
SEARCH_OUTBOX_BATCH_SIZE=20
SEARCH_REBUILD_BATCH_SIZE=250
SEARCH_REBUILD=false

# Qualified views / trending (PostgreSQL is durable; Redis is dedupe + short cache)
VIDEO_VIEW_QUALIFY_SECONDS=10
VIDEO_VIEW_QUALIFY_PERCENT=0.25
VIDEO_VIEW_DEDUPE_TTL=30m
TRENDING_CACHE_TTL=2m
TRENDING_MAX_PAGE_SIZE=50
TRENDING_VIEW_WEIGHT=3
TRENDING_LIKE_WEIGHT=2
TRENDING_FAVORITE_WEIGHT=2
TRENDING_COMMENT_WEIGHT=1.5
TRENDING_AGE_DECAY=0.02

# Deterministic personalized recommendations (PostgreSQL is durable; Redis is a short cache)
RECOMMENDATION_CACHE_TTL=2m
RECOMMENDATION_MAX_PAGE_SIZE=50
RECOMMENDATION_CANDIDATE_LIMIT=200
RECOMMENDATION_SOURCE_LIMIT=50
RECOMMENDATION_HISTORY_LIMIT=200
RECOMMENDATION_AFFINITY_CREATOR_LIMIT=20
RECOMMENDATION_HEAVY_SEEN_THRESHOLD=3
RECOMMENDATION_AFFINITY_WEIGHT=4
RECOMMENDATION_FOLLOWED_WEIGHT=3
RECOMMENDATION_VIEW_WEIGHT=1.5
RECOMMENDATION_LIKE_WEIGHT=1.2
RECOMMENDATION_FAVORITE_WEIGHT=1.5
RECOMMENDATION_COMMENT_WEIGHT=0.8
RECOMMENDATION_FRESHNESS_HOURS=48
RECOMMENDATION_FRESHNESS_WEIGHT=0.05
RECOMMENDATION_SEEN_PENALTY=4
RECOMMENDATION_HEAVY_SEEN_PENALTY=10

# Observability (sampled outbox backlog gauges; does not change .env automatically)
OUTBOX_SAMPLE_INTERVAL=15s

# Media delivery (M13). Copy these into your local .env.
# proxy = Spring streams media bytes (M5–M12 behavior)
# presigned = API rewrites HLS playlists; segments/content/thumbnails use short-lived MinIO URLs
MEDIA_DELIVERY_MODE=presigned
MEDIA_DELIVERY_URL_TTL=15m
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MEDIA_DELIVERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# Production-like Compose reverse proxy (docker-compose.prod.yml)
PROXY_PORT=8088
CADDY_MAX_BODY=32MB
